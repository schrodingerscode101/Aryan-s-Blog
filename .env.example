# Copy this file to .env for local testing. On Vercel, you set these same
# names under Project Settings -> Environment Variables instead - some are
# added there automatically when you connect the storage integrations.

# Only used for local development (npm start)
PORT=3000

# A long, random, secret string used to sign admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Set to "true" once your site is live on Vercel (which is always HTTPS).
# Keep "false" only for local http://localhost testing.
COOKIE_SECURE=false

# --- Admin login ---
# Generate both of these with: npm run create-admin
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Contact form encryption ---
# Generate with: npm run generate-keys
# (the matching PRIVATE key is saved locally and should never go in an env var)
PUBLIC_KEY_PEM=

# --- Data storage (Upstash Redis) ---
# On Vercel: added automatically when you connect the Upstash integration
# under Storage -> Create Database -> Redis.
# For local testing: create a free database at https://upstash.com and
# paste its REST URL/token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Image storage (Vercel Blob) ---
# On Vercel: added automatically when you create a Blob store under
# Storage -> Create Database -> Blob.
# For local testing: create one from your Vercel dashboard and paste the
# token here.
BLOB_READ_WRITE_TOKEN=
